# Add to the repository root .env.local. Never commit real credentials.
# Preferred: use your existing Discord bot.
DISCORD_BOT_TOKEN=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_NEWS_CHANNEL_NAME=stock-news
DISCORD_GUILD_ID=
# Alternative transport; takes precedence when set.
DISCORD_NEWS_WEBHOOK_URL=
# Optional SEC identification override, for example: product/1.0 contact@example.com
SEC_USER_AGENT=

# Required for GitHub Actions (already used by the scanner). Apply migration 026.
NEWS_STATE_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
